{
  "name": "quiz-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "A web app for creating and playing quiz games",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/checks/secret-scan.mjs",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/check.ts",
    "content:packet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/packet.ts",
    "content:record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/record.ts",
    "content:estimate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/estimate.ts",
    "content:decide": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/decide.ts",
    "content:reinstate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/reinstate.ts",
    "content:dedupe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/dedupe.ts",
    "content:datasets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=UNDICI-EHPA --use-env-proxy scripts/content/datasets.ts",
    "content:batch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/batch.ts",
    "content:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/keygen.ts",
    "content:seal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/seal.ts",
    "content:unseal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/unseal.ts",
    "content:stats": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/stats.ts",
    "check": "npm run check:secrets && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
