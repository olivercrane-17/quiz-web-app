{
  "name": "quiz-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "A web app for creating and playing quiz games",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project=!contract-real",
    "test:watch": "vitest --project=!contract-real",
    "test:coverage": "vitest run --project=engine --coverage",
    "test:contract:real": "QZ_REAL_BACKEND=1 vitest run --project=contract-real",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:e2e:perf": "playwright test e2e/perf --project=desktop-chromium",
    "perf:lighthouse": "lhci autorun",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:lazy": "node scripts/checks/lazy-markers.mjs",
    "check:imports": "node scripts/checks/forbidden-imports.mjs",
    "check:ac": "node scripts/checks/ac-coverage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/checks/secret-scan.mjs",
    "content:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/build.ts",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/check.ts",
    "content:packet": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/packet.ts",
    "content:packets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/packet.ts",
    "content:record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/record.ts",
    "content:estimate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/estimate.ts",
    "content:decide": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/decide.ts",
    "content:reinstate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/reinstate.ts",
    "content:dedupe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/dedupe.ts",
    "content:datasets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=UNDICI-EHPA --use-env-proxy scripts/content/datasets.ts",
    "content:batch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/batch.ts",
    "content:keygen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/keygen.ts",
    "content:seal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/seal.ts",
    "content:unseal": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/unseal.ts",
    "content:stats": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/stats.ts",
    "content:release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/release.ts",
    "content:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/audit.ts",
    "content:lists": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/lists/index.ts",
    "content:schedule": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/schedule.ts",
    "content:weekly": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/weekly.ts",
    "sql:gen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sql/gen-parity.ts",
    "sql:bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sql/bundle-tests.ts",
    "sql:drift": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sql/drift-check.ts",
    "sql:advisors": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sql/advisors-diff.ts",
    "codegen:analytics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/codegen/analytics-sql.ts",
    "codegen:moderation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/codegen/moderation-sql.ts",
    "check": "npm run check:secrets && npm run lint && npm run typecheck && npm run test && npm run test:coverage"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "inapp-spy": "5.0.10",
    "next": "16.4.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "serwist": "9.5.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@serwist/cli": "9.5.13",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "subset-font": "2.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "@serwist/cli": {
      "zod": "4.6.7"
    }
  }
}
