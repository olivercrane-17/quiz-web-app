# Copy to .env.local for local development: cp .env.example .env.local
# .env.local is git-ignored. Never commit real secrets.
#
# Every variable here is NEXT_PUBLIC_*: Next.js inlines it into the browser
# bundle at build time, so only put public values here, and rebuild (or
# restart `next dev`) after a change. All of them are optional.
# src/lib/env.ts validates them and falls back to safe defaults, so a missing
# or broken value never crashes the app.
#
# Variables exported in your shell (or set on Vercel) win over this file,
# one name at a time. Run `env | grep NEXT_PUBLIC` if a build talks to the
# wrong project: `npm run build` prints the backend it uses.

# Which backend the app talks to:
#   supabase  the real Supabase project (default)
#   mock      in-app mock backend with no network calls (E2E tests use this)
#   off       no backend; backend features hide or fall back to local-only
# Use mock when Supabase is unreachable from your machine.
NEXT_PUBLIC_BACKEND_MODE=supabase

# Supabase project URL and publishable key (Dashboard > Project Settings >
# API Keys). Leave both unset to use the project's built-in public values
# from src/lib/env-parse.ts. To use another project, set the URL and its key
# together, as a pair: if only one of them comes from here, the other may
# come from your shell and belong to a different project. Never put an
# sb_secret_ or service_role key in a NEXT_PUBLIC_ variable. The build fails
# if you do, because the key would ship to every browser.
# NEXT_PUBLIC_SUPABASE_URL=https://zcodouduyvxwefxebvmv.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_u6KrUSv5WrxoakIDBd1i4w_4JPB01ts

# Legacy JWT "anon" key. Only read when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# is unset. Prefer the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public URL of the site, without a trailing slash. Used for
# metadata, share links and auth redirects. When unset, Vercel deployments use
# their production or preview URL automatically (NEXT_PUBLIC_VERCEL_* system
# variables) and local runs use http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://quiz.example.com
