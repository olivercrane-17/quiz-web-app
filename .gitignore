# ---------------------------------------------------------------------------
# Project additions (Next.js, Vercel, testing)
# ---------------------------------------------------------------------------

# Next.js: generated on every dev, build and typegen run.
# See https://nextjs.org/docs/app/api-reference/config/typescript#next-env-dts
next-env.d.ts

# Local env files. ".env" and ".env.*" above already cover these, and
# ".env.example" stays tracked. Listed explicitly for clarity.
.env*.local

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Lighthouse CI (npm run perf:lighthouse) reports
/.lighthouseci/

# Service worker, generated after `next build` (ARCHITECTURE §10.7)
/public/sw.js
/public/sw.js.map

# Vercel CLI
.vercel

# OS and editor noise
.DS_Store
*.pem

# Agent worktrees
.claude/worktrees/

# Content pipeline (CONTENT_GUIDE §11.2, ARCHITECTURE §5.4). The secret scan
# (npm run check:secrets) fails if any of these is ever tracked.
# Plaintext workspace for sealed content. Envelopes live in content/sealed/.
content/.sealed-plain/
# Blind packets, downloaded datasets and other tool caches.
.cache/
# Sealed release SQL, applied through MCP and never committed.
supabase/.generated/
